#include <windows.h>

#include "version.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION TBM_VERSION_MAJOR, TBM_VERSION_MINOR, TBM_VERSION_PATCH, 0
PRODUCTVERSION TBM_VERSION_MAJOR, TBM_VERSION_MINOR, TBM_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Taskbar Monitor"
      VALUE "ProductName", "Taskbar Monitor"
      VALUE "FileVersion", TBM_VERSION_STRING
      VALUE "ProductVersion", TBM_VERSION_STRING
      VALUE "OriginalFilename", "TaskbarMonitor.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
